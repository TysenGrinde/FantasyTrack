@page
@model FantasySports.Pages.TeamsModel
@{
	Layout = "_Layout";
}

<h2>Teams</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-page-handler="CreateTeam" class="mb-4">
    <div class="input-group">
        <input type="text" class="form-control" name="teamName" placeholder="Team Name" required>
        <button type="submit" class="btn btn-primary">Create Team</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var team in Model.Teams)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@team.Name</h5>
                    <p class="card-text">
                        @if (team.Athletes.Any())
                        {
                            <span>Members: @team.Athletes.Count</span>
                        }
                        else
                        {
                            <span class="text-muted">No members yet</span>
                        }
                    </p>
                </div>
                <div class="card-footer">
                    <a href="/Draft?teamId=@team.Id" class="btn btn-sm btn-success">Draft Players</a>
                </div>
            </div>
        </div>
    }
</div>