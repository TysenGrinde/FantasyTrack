@page
@model FantasySports.Pages.IndexModel
@{
    Layout = "_Layout";
}
<h2>Athletes</h2>

<form method="post" asp-page-handler="AddAthlete" class="mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" class="form-control" name="id" placeholder="ID" required>
        </div>
        <div class="col-md-5">
            <input type="text" class="form-control" name="name" placeholder="Athlete Name" required>
        </div>
        <div class="col-md-5">
            <input type="text" class="form-control" name="sport" placeholder="Sport" required>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Athlete</button>
        </div>
    </div>
</form>

<div class="list-group">
    @foreach (var athlete in Model.Athletes)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-1">@athlete.Name</h5>
                <small class="text-muted"></small>
            </div>
            <span class="badge bg-secondary rounded-pill">ID: @athlete.Id</span>
        </div>
    }
</div>