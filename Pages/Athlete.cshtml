@page
@model FantasySports.Pages.AthleteModel
@{
    Layout = "_Layout";
}

<h2 class="mb-4">Athletes</h2>

<div class="list-group">
    @foreach (var athlete in Model.Athlete)
    {
        <div class="list-group-item">
            <div class="row align-items-center gx-3">
                <!-- Image Column -->
                <div class="col-auto">
                    <img src="@(athlete.ImageURL ?? "/images/placeholder.jpg")"
                         alt="@athlete.Name"
                         class="athlete-img rounded-circle" />
                </div>

                <!-- Name Column (flexible width) -->
                <div class="col text-truncate">
                    <h5 class="mb-0">@athlete.Name</h5>
                </div>

                <!-- ID Column -->
                <div class="col-auto">
                    <span class="badge bg-secondary rounded-pill">ID: @athlete.Id</span>
                </div>

                @if (athlete.TeamId != null)
                {
                    <!-- Team ID Column -->
                    <div class="col-auto">
                        <span class="badge bg-secondary rounded-pill">Team: @athlete.TeamId</span>
                    </div>
                }

                <!-- Status Column -->
                <div class="col-auto">
                    <span class="badge @(athlete.TeamId == null ? "bg-success" : "bg-warning text-dark") rounded-pill">
                        @(athlete.TeamId == null ? "Available" : "Unavailable")
                    </span>
                </div>

                <!-- Position Box (far right) -->
                <div class="col-auto position-box">
                    <span>@athlete.Position</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .athlete-img {
        width: 50px;
        height: 50px;
        object-fit: cover;
    }

    .list-group-item {
        padding: 1rem;
    }

    .position-box {
        min-width: 150px;
        height: 30px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto; /* Pushes to far right */
        padding: 0 10px;
    }

        .position-box span {
            font-weight: 500;
            color: #495057;
            text-align: center;
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .position-box {
            min-width: 60px;
            height: 25px;
            font-size: 0.8rem;
        }

        .athlete-img {
            width: 40px;
            height: 40px;
        }
    }
</style>