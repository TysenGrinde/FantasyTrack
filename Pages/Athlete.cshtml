@page
@model FantasySports.Pages.AthleteModel
@{
    Layout = "_Layout";
}
<h2>Athletes</h2>

<div class="list-group">
    @foreach (var athlete in Model.Athlete)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <img src="@(athlete.ImageURL ?? "/images/placeholder.jpg")"
                 alt="@athlete.Name"
                 class="athlete-img" />
            <div>
                <h5 class="mb-1">@athlete.Name</h5>
                <small class="text-muted"></small>
            </div>
            <p class="mb-0">@athlete.Position</p>
            <span class="badge bg-secondary rounded-pill">ID: @athlete.Id</span>
            <!-- If an Athletes TeamId == NULL then say "Free Agent", if not null say TeamId-->
            <span class="badge bg-secondary rounded-pill">
                @if (athlete.TeamId == null)
                {
                    <text>Available</text>
                }
                else
                {
                    <text>Unavailable</text>
                }
        </div>
    }
</div>