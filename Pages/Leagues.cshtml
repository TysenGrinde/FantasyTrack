@page
@model FantasySports.Pages.LeaguesModel
@{
	Layout = "_Layout";
}

<h2>Leagues</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-page-handler="CreateLeague" class="mb-4">
    <div class="input-group">
        <input type="text" class="form-control" name="leagueName" placeholder="League Name" required>
        <button type="submit" class="btn btn-primary">Create League</button>
    </div>
</form>

<div class="list-group">
    @foreach (var league in Model.Leagues)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@league.Name</h5>
                </div>
                <form method="post" asp-page-handler="JoinLeague">
                    <input type="hidden" name="leagueId" value="@league.Id">
                    <select name="teamId" class="form-select form-select-sm me-2" style="width: 150px;">
                        @foreach (var team in await Model.GetAvailableTeams())
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-success">Join</button>
                </form>
            </div>
        </div>
    }
</div>