@page "{id:int}"
@model FantasySports.Pages.Athletes.DetailsModel
@{
    ViewData["Title"] = "Athlete Details";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <img src="@(Model.Athlete.ImageURL ?? "/images/placeholder.jpg")"
                     class="card-img-top"
                     alt="@Model.Athlete.Name">
                <div class="card-body">
                    <h2 class="card-title">@Model.Athlete.Name</h2>
                    <p class="card-text">
                        <strong>Position:</strong> @Model.Athlete.Position<br>
                        <strong>Team:</strong> @(Model.Athlete.Team?.Name ?? "Free Agent")
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Performance History</h3>
                </div>
                <div class="card-body">
                    @if (Model.Performances.Any())
                    {
                        <div class="table-responsive">
                            @foreach (var meetGroup in Model.Performances
                           .GroupBy(p => p.MeetEvent?.Meet)
                           .OrderByDescending(g => g.Key?.Date))
                            {
                                <div class="mb-4">
                                    <h4 class="mb-3">@meetGroup.Key?.Name - @meetGroup.Key?.Date.ToShortDateString()</h4>
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Event</th>
                                                <th>Result</th>
                                                <th>Points</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var performance in meetGroup.OrderBy(p => p.MeetEvent?.Event?.Name))
                                            {
                                                <tr>
                                                    <td>@performance.MeetEvent?.Event?.Name</td>
                                                    <td>@performance.Result @performance.MeetEvent?.Event?.Unit</td>
                                                    <td>@performance.PointsEarned</td>
                                                </tr>
                                            }
                                            <tr class="table-info">
                                                <td colspan="2"><strong>Total Points</strong></td>
                                                <td><strong>@meetGroup.Sum(p => p.PointsEarned)</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">No performance records found for this athlete.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="./Index" class="btn btn-secondary">Back to Athletes List</a>
    </div>
</div>