@page
@model FantasySports.Pages.DraftModel
@{
	Layout = "_Layout";
}

<h2>Draft Players for @Model.CurrentTeam?.Name</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Available Athletes</h4>
        <div class="list-group">
            @foreach (var athlete in Model.AvailableAthletes)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@athlete.Name</h5>
                        <small class="text-muted"></small>
                    </div>
                    <form method="post" asp-page-handler="MakePick">
                        <input type="hidden" name="teamId" value="@Model.CurrentTeam?.Id">
                        <input type="hidden" name="athleteId" value="@athlete.Id">
                        <button type="submit" class="btn btn-sm btn-success">Draft</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <h4>Current Team</h4>
        @if (Model.CurrentTeam?.Athletes.Any() == true)
        {
            <ul class="list-group">
                @foreach (var athlete in Model.CurrentTeam.Athletes)
                {
                    <li class="list-group-item">@athlete.Name</li>
                }
            </ul>
        }
        else
        {
            <div class="alert alert-info">No athletes drafted yet</div>
        }
    </div>
</div>
