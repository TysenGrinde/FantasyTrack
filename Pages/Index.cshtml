@page
@model FantasySports.Pages.IndexModel
@{
    Layout = "_Layout";
}

<div class="container-fluid" style="display: flex; width: 100%; height: 100vh; margin: 0; padding: 0;">
    <!-- Left Side: Navigation Links -->
    <div class="bg-light p-3" style="flex: 0 0 20%; min-height: 100vh;">
        <h4>Team Management</h4>
        <ul class="list-unstyled">
            <li>
                <a asp-page="/League/MyTeam/Index" style="text-decoration: none; color: black;">
                    <i class="fas fa-users" style="margin-right: 8px;"></i>My Team
                </a>
            </li>
            <li>
                <a href="#" style="text-decoration: none; color: black;">
                    <i class="fas fa-chart-bar" style="margin-right: 8px;"></i>Statistics
                </a>
            </li>
        </ul>
        <h4>Draft</h4>
        <ul class="list-unstyled">
            <li>
                <a href="#" style="text-decoration: none; color: black;">
                    <i class="fas fa-list-ol" style="margin-right: 8px;"></i>Draft Order
                </a>
            </li>
            <li>
                <a href="#" style="text-decoration: none; color: black;">
                    <i class="fas fa-history" style="margin-right: 8px;"></i>Draft History
                </a>
            </li>
        </ul>
        <h4>Trades</h4>
        <ul class="list-unstyled">
            <li>
                <a href="#" style="text-decoration: none; color: black;">
                    <i class="fas fa-exchange-alt" style="margin-right: 8px;"></i>Propose a Trade
                </a>
            </li>
            <li>
                <a href="#" style="text-decoration: none; color: black;">
                    <i class="fas fa-clock" style="margin-right: 8px;"></i>Pending Trades
                </a>
            </li>
        </ul>
    </div>

    <!-- Center: League Info -->
    <div class="p-3" style="flex: 0 0 60%; min-height: 100vh;">
        <!-- Current Standings Section -->
        <h4>Current Standings</h4>
        <div class="center-card mb-3">
            <div>
                @{
                    var displayTeams = Model.CurrentLeague.Teams
                    .OrderByDescending(t => t.Wins)
                    .ThenBy(t => t.Losses)
                    .Take(8)
                    .ToList();
                }
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th style="text-align: left; width: 70%;">Teams</th>
                            <th style="text-align: right; width: 10%;">W</th>
                            <th style="text-align: right; width: 10%;">L</th>
                            <th style="text-align: right; width: 10%;">PCT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in displayTeams)
                        {
                            <tr>
                                <td style="text-align: left;">
                                    @if (!string.IsNullOrEmpty(team.LogoUrl))
                                    {
                                        <img src="@team.LogoUrl"
                                             style="height: 20px; width: 20px; margin-right: 8px;"
                                             alt="@team.Name logo" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-question-circle" style="color: #6c757d; margin-right: 8px;"></i>
                                    }
                                    @team.Name
                                </td>
                                <td style="text-align: right;">@team.Wins</td>
                                <td style="text-align: right;">@team.Losses</td>
                                <td style="text-align: right;">
                                    @{
                                        var pct = team.Wins + team.Losses > 0
                                        ? (team.Wins * 100.0 / (team.Wins + team.Losses)).ToString("0.0") + "%"
                                        : "0.0%";
                                    }
                                    @pct
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Head to Head Section - Updated -->
        <h4>Recent Head to Head</h4>
        @if (Model.UserTeamMatchups.Any())
        {
            @foreach (var matchup in Model.UserTeamMatchups.OrderByDescending(m => m.Meet.Date).Take(3))
            {
                <div class="center-card mb-3">
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 8px;">
                        <span>@matchup.Meet.Date.ToString("yyyy-MM-dd")</span>
                        <span style="font-weight: bold;">Final</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 1rem;">
                        <span>
                            @if (matchup.HomeTeam.Id == Model.CurrentUserTeam.Id)
                            {
                                <div><strong>
                                    <img src="@matchup.HomeTeam.LogoUrl" style="height: 40px; width: 40px; margin-right: 10px; object-fit: contain;" />
                                    @matchup.HomeTeam.Name (@matchup.HomeTeamScore)
                                </strong></div>
                            }
                            else
                            {
                                <div>
                                        <img src="@matchup.HomeTeam.LogoUrl" style="height: 40px; width: 40px; margin-right: 10px; object-fit: contain;" />
                                        @matchup.HomeTeam.Name (@matchup.HomeTeamScore)
                                </div>
                            }
                        </span>
                        <span>
                            @if (matchup.AwayTeam.Id == Model.CurrentUserTeam.Id)
                            {
                                <strong><div>
                                    (@matchup.AwayTeamScore) @matchup.AwayTeam.Name
                                    <img src="@matchup.AwayTeam.LogoUrl" style="height: 40px; width: 40px; margin-right: 10px; object-fit: contain;" />
                                </div></strong>
                            }
                            else
                            {
                                <div>
                                    (@matchup.AwayTeamScore) @matchup.AwayTeam.Name
                                    <img src="@matchup.AwayTeam.LogoUrl" style="height: 40px; width: 40px; margin-right: 10px; object-fit: contain;" />
                                </div>
                            }
                        </span>
                    </div>
                    <div style="text-align: center; margin-top: 8px;">
                        @if (matchup.HomeTeamScore == matchup.AwayTeamScore)
                        {
                            <span class="badge bg-info">TIED</span>
                        }
                        else if ((matchup.HomeTeamScore > matchup.AwayTeamScore && matchup.HomeTeam.Id == Model.CurrentUserTeam.Id) ||
                        (matchup.AwayTeamScore > matchup.HomeTeamScore && matchup.AwayTeam.Id == Model.CurrentUserTeam.Id))
                        {
                            <span class="badge bg-success">WIN</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">LOSS</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">No recent matchups found for your team.</div>
        }
    </div>

    <!-- Right Side: Available Athletes -->
    <div class="bg-light p-3" style="flex: 0 0 20%; min-height: 100vh; position: relative;">
        <h4>Available Athletes</h4>
        <div class="athletes-container" style="max-height: calc(100vh - 200px); overflow-y: auto;">
            @foreach (var athlete in Model.AvailableAthletes)
            {
                <div class="athlete-card mb-3">
                    <div class="d-flex align-items-center">
                        <img src="@(athlete.ImageURL ?? "/images/placeholder.jpg")"
                             alt="@athlete.Name"
                             class="athlete-img"
                             onerror="this.src='/images/placeholder.jpg'" />
                        <div class="ms-3">
                            <p class="mb-1"><strong>@athlete.Name</strong></p>
                            <p class="mb-0">@athlete.Position</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-3" style="position: absolute; bottom: 100px; left: 0; right: 0;">
            <a href="/Athlete" class="btn btn-primary">Show All Athletes</a>
        </div>
    </div>
</div>