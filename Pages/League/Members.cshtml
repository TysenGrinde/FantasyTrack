@page
@model FantasySports.Pages.League.MembersModel
@{
    ViewData["Title"] = "League Members";
}

<div class="members-container">
    <h1>League Members</h1>
    <div class="members-list">
        <table class="table">
            <thead>
                <tr>
                    <th>Team Name</th>
                    <th>Username</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td>@member.TeamName</td>
                        <td>@member.Username</td>
                        <td>@member.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a asp-page="./Index" asp-route-leagueId="@Model.LeagueId" class="btn btn-secondary">Back to League</a>
</div>