@page
@model FantasySports.Pages.Meets.DetailsModel
@{
    Layout = "_Layout";
}

@if (Model.MeetNotFound)
{
    <div class="alert alert-danger">
        <h4>Meet Not Found</h4>
        <p>The requested meet could not be found.</p>
        <a asp-page="./Index" class="btn btn-primary">Back to Meets List</a>
    </div>
}
else
{
    <h2>@Model.Meet.Name - @Model.Meet.Date.ToString("MMMM dd, yyyy")</h2>

    @if (TempData["FinalizeError"] != null)
    {
        <div class="alert alert-danger">
            <h4>Finalization Failed</h4>
            <p>@TempData["FinalizeError"]</p>
        </div>
    }

    @if (!Model.Meet.IsCompleted)
    {
        @if (Model.Meet.Matchups.Count == 0)
        {
            <form method="post" asp-page-handler="ScheduleMatchups" asp-route-meetId="@Model.Meet.Id">
                <button type="submit" class="btn btn-info mb-3">
                    <i class="fas fa-calendar-alt"></i> Schedule Matchups
                </button>
            </form>
        }
        <div class="mb-3">
            <form method="get" asp-page="./EnterPerformance" class="d-inline">
                <input type="hidden" name="MeetId" value="@Model.Meet.Id" />
                <div class="input-group">
                    <select name="EventId" class="form-select" required>
                        <option value="">-- Select Event --</option>
                        @foreach (var evt in Model.Meet.Events.OrderBy(e => e.Event.Name))
                        {
                            <option value="@evt.Id">@evt.Event.Name (@evt.Event.Unit)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add Performance
                    </button>
                </div>
            </form>

            <form method="post" asp-page-handler="Finalize" class="d-inline ms-2">
                <input type="hidden" name="id" value="@Model.Meet.Id" />
                <button type="submit" class="btn btn-danger">Finalize Meet</button>
            </form>
        </div>
        @foreach (var meetEvent in Model.Meet.Events.OrderBy(e => e.Event.Name))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h3>@meetEvent.Event.Name</h3>
                    <a asp-page="./EnterPerformance"
                       asp-route-MeetId="@Model.Meet.Id"
                       asp-route-EventId="@meetEvent.Id"
                       class="btn btn-sm btn-outline-primary">
                        Add Performance
                    </a>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Athlete</th>
                                <th>Team</th>
                                <th>Result</th>
                                @if (Model.Meet.IsCompleted)
                                {
                                    <th>Points</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ordered = meetEvent.Event.Unit == "seconds"
                                ? meetEvent.Performances.OrderBy(p => p.Result)
                                : meetEvent.Performances.OrderByDescending(p => p.Result);
                            }
                            @foreach (var perf in ordered)
                            {
                                <tr>
                                    <td>@(perf.PointsEarned > 0 ? perf.PointsEarned + " pts" : "-")</td>
                                    <td>@perf.Athlete.Name</td>
                                    <td>@(perf.Athlete.Team?.Name ?? "Unaffiliated")</td>
                                    <td>@perf.Result @meetEvent.Event.Unit</td>
                                    @if (Model.Meet.IsCompleted)
                                    {
                                        <td>@perf.PointsEarned</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (Model.Meet.Matchups.Any())
        {
            <div class="card mt-4">
                <div class="card-header bg-dark text-white">
                    <h3>Team Matchups</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Matchup</th>
                                <th>Home Score</th>
                                <th>Away Score</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var matchup in Model.Meet.Matchups)
                            {
                                <tr>
                                    <td>
                                        @matchup.HomeTeam.Name vs @matchup.AwayTeam.Name
                                    </td>
                                    <td>@(matchup.HomeTeamScore?.ToString() ?? "-")</td>
                                    <td>@(matchup.AwayTeamScore?.ToString() ?? "-")</td>
                                    <td>
                                        @if (matchup.IsCompleted)
                                        {
                                            if (matchup.HomeTeamScore == matchup.AwayTeamScore)
                                            {
                                                <span class="badge bg-info">TIED</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(matchup.HomeTeamScore > matchup.AwayTeamScore ? "bg-success" : "bg-secondary")">
                                                    @(matchup.HomeTeamScore > matchup.AwayTeamScore ? "WON" : "LOST")
                                                </span>
                                                <span>@matchup.HomeTeam.Name</span>
                                                <span class="badge @(matchup.AwayTeamScore > matchup.HomeTeamScore ? "bg-success" : "bg-secondary")">
                                                    @(matchup.AwayTeamScore > matchup.HomeTeamScore ? "WON" : "LOST")
                                                </span>
                                                <span>@matchup.AwayTeam.Name</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            This meet has been finalized on @Model.Meet.TeamScores.First().DateCreated.ToString("g")
        </div>
    }

@if (Model.Meet.IsCompleted)
{
    @if (Model.Meet.Matchups.Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-dark text-white">
                <h3>Team Matchups</h3>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Matchup</th>
                            <th>Home Score</th>
                            <th>Away Score</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var matchup in Model.Meet.Matchups)
                        {
                            <tr>
                                <td>
                                    @matchup.HomeTeam.Name vs @matchup.AwayTeam.Name
                                </td>
                                <td>@(matchup.HomeTeamScore?.ToString() ?? "-")</td>
                                <td>@(matchup.AwayTeamScore?.ToString() ?? "-")</td>
                                <td>
                                    @if (matchup.IsCompleted)
                                    {
                                        <span class="badge @(matchup.HomeTeamScore > matchup.AwayTeamScore ? "bg-success" : "bg-secondary")">
                                            @matchup.HomeTeam.Name @(matchup.HomeTeamScore > matchup.AwayTeamScore ? "WON" : "LOST")
                                        </span>
                                        <span class="badge @(matchup.AwayTeamScore > matchup.HomeTeamScore ? "bg-success" : "bg-secondary")">
                                            @matchup.AwayTeam.Name @(matchup.AwayTeamScore > matchup.HomeTeamScore ? "WON" : "LOST")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="card">
        <div class="card-header">
            <h3>Final Team Standings</h3>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Place</th>
                        <th>Team</th>
                        <th>Total Points</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var score in Model.Meet.TeamScores.OrderBy(s => s.Placement))
                    {
                        <tr>
                            <td>@score.Placement</td>
                            <td>@score.Team.Name</td>
                            <td>@score.TotalPoints</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        @foreach (var meetEvent in Model.Meet.Events.OrderBy(e => e.Event.Name))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h3>@meetEvent.Event.Name</h3>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Athlete</th>
                                <th>Team</th>
                                <th>Result</th>
                                @if (Model.Meet.IsCompleted)
                                {
                                    <th>Points</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ordered = meetEvent.Event.Unit == "seconds"
                                ? meetEvent.Performances.OrderBy(p => p.Result)
                                : meetEvent.Performances.OrderByDescending(p => p.Result);
                            }
                            @foreach (var perf in ordered)
                            {
                                <tr>
                                    <td>@(perf.PointsEarned > 0 ? perf.PointsEarned + " pts" : "-")</td>
                                    <td>@perf.Athlete.Name</td>
                                    <td>@(perf.Athlete.Team?.Name ?? "Unaffiliated")</td>
                                    <td>@perf.Result @meetEvent.Event.Unit</td>
                                    @if (Model.Meet.IsCompleted)
                                    {
                                        <td>@perf.PointsEarned</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
}
}